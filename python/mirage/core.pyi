"""Public Python interface of the Cython extension in _cython/core.pyx."""
from ctypes import c_void_p
from typing import Any, ClassVar, TypedDict
import torch


class TritonProgram(TypedDict):
    code: str
    output_shapes: list[list[int]]


class dtype:
    name: str
    SINT_TYPES: ClassVar[list[str]]
    UINT_TYPES: ClassVar[list[str]]
    FP_TYPES: ClassVar[list[str]]
    def __init__(self, name: str | None) -> None: ...
    def is_fp8(self) -> bool: ...
    def is_fp16(self) -> bool: ...
    def is_bf16(self) -> bool: ...
    def is_fp32(self) -> bool: ...
    def is_fp64(self) -> bool: ...
    def is_int1(self) -> bool: ...
    def is_int8(self) -> bool: ...
    def is_int16(self) -> bool: ...
    def is_int32(self) -> bool: ...
    def is_int64(self) -> bool: ...
    def is_uint8(self) -> bool: ...
    def is_uint16(self) -> bool: ...
    def is_uint32(self) -> bool: ...
    def is_uint64(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __str__(self) -> str: ...
    @staticmethod
    def is_dtype(type_str: str) -> bool: ...
def get_kn_operator_type_string(op_type: int) -> str: ...
def get_tb_operator_type_string(op_type: int) -> str: ...
def convert_dtype_to_ctype(type: dtype) -> int: ...
def convert_dtype_to_torch_type(type: dtype) -> torch.dtype: ...
def convert_ctype_to_dtype(type: int) -> dtype: ...
def convert_torch_type_to_dtype(type: torch.dtype) -> dtype: ...
def string_to_tbepilogue(epilogue: str | None) -> int: ...
def string_to_accum_optype(acc: str | None) -> int: ...
def string_to_accum_rescale_optype(acc: str | None) -> int: ...

class DTensor:
    @property
    def guid(self) -> int | None: ...
    @property
    def base_guid(self) -> int | None: ...
    @property
    def view_offset(self) -> int | None: ...
    @property
    def is_virtual(self) -> bool: ...
    @property
    def tensor(self) -> c_void_p | None: ...
    @tensor.setter
    def tensor(self, value: Any) -> None: ...
    @property
    def num_dims(self) -> int | None: ...
    @property
    def dtype(self) -> dtype | None: ...
    def __init__(self, tensor: Any) -> None: ...
    def dim(self, idx: int) -> int | None: ...
    @property
    def shape(self) -> tuple[int, ...] | None: ...
    @property
    def stride(self) -> tuple[int, ...] | None: ...

class STensor:
    @property
    def guid(self) -> int | None: ...
    @property
    def tensor(self) -> c_void_p | None: ...
    @tensor.setter
    def tensor(self, value: Any) -> None: ...
    @property
    def num_dims(self) -> int | None: ...
    @property
    def dtype(self) -> dtype | None: ...
    def __init__(self, tensor: Any) -> None: ...
    def dim(self, idx: int) -> int | None: ...

class CyKNOperator:
    def get_input_dtensors(self) -> list[DTensor]: ...
    def get_output_dtensors(self) -> list[DTensor]: ...
    @property
    def op_type(self) -> str | None: ...
    def __init__(self, op: Any) -> None: ...

class CyKNCustomizedOp(CyKNOperator):
    def __init__(self, op: Any) -> None: ...
    def get_bgraph(self) -> CyTBGraph: ...

class CyTBOperator:
    def get_input_stensors(self) -> list[STensor]: ...
    def get_output_stensors(self) -> list[STensor]: ...
    @property
    def op_type(self) -> str | None: ...
    def __init__(self, op: Any) -> None: ...

class CyTBInputOp(CyTBOperator):
    def __init__(self, op: Any) -> None: ...
    @property
    def input_map(self) -> tuple[int, int, int] | None: ...
    @property
    def forloop_dim(self) -> int | None: ...
    @property
    def dtensor_guid(self) -> int | None: ...

class CyTBOutputOp(CyTBOperator):
    def __init__(self, op: Any) -> None: ...
    @property
    def output_map(self) -> tuple[int, int, int] | None: ...
    @property
    def forloop_dim(self) -> int | None: ...
    @property
    def dtensor_guid(self) -> int | None: ...

class CyKNGraph:
    def __init__(self, graph: Any = ..., disable_fingerprint: bool = ...) -> None: ...
    def new_input(self, dims: tuple[int, ...], strides: tuple[int, ...], dtype: dtype = ...) -> DTensor: ...
    def mark_output(self, A: DTensor, strides: tuple[int, ...] | None) -> None: ...
    def matmul(self, A: DTensor, B: DTensor) -> DTensor: ...
    def reduction(self, input: DTensor, dim: int) -> DTensor: ...
    def rms_norm(self, input: DTensor, normalized_shape: tuple[int, ...]) -> DTensor: ...
    def exp(self, input: DTensor) -> DTensor: ...
    def silu(self, input: DTensor) -> DTensor: ...
    def gelu(self, input: DTensor) -> DTensor: ...
    def relu(self, input: DTensor) -> DTensor: ...
    def clamp(self, input: DTensor, min_val: float, max_val: float) -> DTensor: ...
    def sqrt(self, input: DTensor) -> DTensor: ...
    def square(self, input: DTensor) -> DTensor: ...
    def add(self, A: DTensor, B: DTensor) -> DTensor: ...
    def mul(self, A: DTensor, B: DTensor) -> DTensor: ...
    def div(self, A: DTensor, B: DTensor) -> DTensor: ...
    def pow(self, A: DTensor, B: DTensor) -> DTensor: ...
    def customized(self, inputs: list[DTensor], bgraph: CyTBGraph) -> list[DTensor]: ...
    def generate_triton_program(self, filepath: str) -> None: ...
    def get_input_dtensors(self) -> list[DTensor]: ...
    def get_owner_independent_hash(self) -> int: ...
    def get_graph_structure(self) -> Any: ...
    def get_num_inputs(self) -> int: ...
    def get_num_outputs(self) -> int: ...
    def get_input_dtensor_shape_and_stride(self, A: DTensor) -> tuple[tuple[int, ...], tuple[int, ...]]: ...
    def attach_torch_tensor(self, tensor: DTensor, torch_tensor: torch.Tensor, name: str | None) -> None: ...
    def attach_cuda_tensor(self, tensor: DTensor, name: str | None) -> None: ...
    def attach_nvshmem_tensor(self, tensor: DTensor, name: str | None) -> None: ...
    def fuse_tensors(self, inputs: list[DTensor], fused_dim: int, num_groups: int, name: str | None) -> DTensor: ...
    def shuffle_tensors(self, inputs: list[DTensor], shuffled_dim: int, num_groups: int, name: str | None) -> DTensor: ...
    def view(self, input: DTensor, new_shape: list[int]) -> DTensor: ...
    def narrow(self, input: DTensor, dim: int, start: int, length: int) -> DTensor: ...
    def split(self, input: DTensor, sizes_or_chunks: int | list[int] | tuple[int, ...], dim: int) -> list[DTensor]: ...
    def register_task(self, bgraph: CyTBGraph, task_type: str, params: list[int]) -> None: ...
    def generate_task_graph(self, num_gpus: int, my_gpu_id: int) -> dict[str, str]: ...

class CyTBGraph:
    def __init__(self, grid_dim: tuple[int, ...] = ..., block_dim: tuple[int, ...] = ..., forloop_range: int = ..., dimx: int = ..., bgraph: Any = ...) -> None: ...
    def new_input(self, dtensor: DTensor, input_map: tuple[int, ...], forloop_dim: int, store_in_dmem: bool = ...) -> STensor: ...
    def new_output(self, stensor: STensor, output_map: tuple[int, ...], forloop_dim: int, epilogue: str | None = ...) -> None: ...
    def matmul(self, A: STensor, B: STensor) -> STensor: ...
    def exp(self, A: STensor) -> STensor: ...
    def silu(self, A: STensor) -> STensor: ...
    def gelu(self, A: STensor) -> STensor: ...
    def relu(self, A: STensor) -> STensor: ...
    def clamp(self, A: STensor, min_val: float, max_val: float) -> STensor: ...
    def square(self, A: STensor) -> STensor: ...
    def sqrt(self, A: STensor) -> STensor: ...
    def mul_scalar(self, A: STensor, scalar: float) -> STensor: ...
    def add(self, A: STensor, B: STensor) -> STensor: ...
    def mul(self, A: STensor, B: STensor) -> STensor: ...
    def div(self, A: STensor, B: STensor) -> STensor: ...
    def sub(self, A: STensor, B: STensor) -> STensor: ...
    def reduction(self, A: STensor, dim: int) -> STensor: ...
    def reduction_max(self, A: STensor, dim: int) -> STensor: ...
    def rms_norm(self, A: STensor) -> STensor: ...
    def concat(self, A: STensor, B: STensor, dim: int) -> STensor: ...
    def forloop_accum(self, A: STensor, acc: str | None) -> STensor: ...
    def forloop_accum_rescale(self, A: STensor, B: STensor, acc: str | None) -> STensor: ...
    def forloop_accum_max(self, A: STensor) -> STensor: ...
    @property
    def grid_dim(self) -> dict[str, int]: ...
    @property
    def forloop_range(self) -> int: ...
    @property
    def operators(self) -> list[CyTBOperator]: ...
def search(input_graph: CyKNGraph, *, backend: str = ..., max_num_new_graphs: int = ..., imaps: list[Any] | None = ..., omaps: list[Any] | None = ..., griddims: list[Any] | None = ..., blockdims: list[Any] | None = ..., fmaps: list[Any] | None = ..., franges: list[Any] | None = ..., previous_checkpoint: str | None = ..., verbose: bool, default_config: str | None = ..., is_formal_verified: bool) -> list[CyKNGraph]: ...
def generate_cuda_program(input_graph: CyKNGraph, *, target_cc: int, input_strides: list[Any], num_warp_groups: int = ..., pipeline_stages: int = ..., profiling: bool = ..., enable_online_softmax: bool = ...) -> dict[str, Any]: ...
def generate_nki_program(input_graph: CyKNGraph, *, target_cc: int) -> dict[str, Any]: ...
def generate_triton_program(input_graph: CyKNGraph, *, target_cc: int) -> TritonProgram: ...
def set_gpu_device_id(gpu_id: int) -> None: ...
def cy_to_json(input_graph: CyKNGraph, filename: str | None) -> None: ...
def cy_from_json(filename: str) -> CyKNGraph: ...

